# =============================================================================
# mcp-perplexity — MCP server สำหรับค้นหาข้อมูลบนเว็บผ่าน Perplexity — ตัวอย่างไฟล์ .env
# เครื่องมือ: perplexity_search / perplexity_ask / perplexity_reason / perplexity_research
# -----------------------------------------------------------------------------
# ไฟล์นี้อธิบายการตั้งค่าทั้งหมดที่ปรับได้ โดยแบ่งเป็น 5 หมวดเช่นเดียวกับไฟล์ .env
# บรรทัดที่ไม่มี # นำหน้าคือค่าที่จำเป็นต้องกำหนดในไฟล์ .env
# บรรทัดที่มี # นำหน้าคือค่าเริ่มต้น หากไม่กำหนดในไฟล์ .env ระบบจะใช้ค่านี้
# เมื่อแก้ไขไฟล์ .env แล้ว ให้สั่ง docker compose up -d เพื่อสร้าง container ใหม่
# =============================================================================

# --- Perplexity API ---
# API key (ค่าลับ) ขอได้ที่ https://console.perplexity.ai ทุกการเรียกใช้เครื่องมือจะคิดค่าใช้จ่ายกับ key นี้
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# เวลารอคำตอบจาก Perplexity สูงสุด (มิลลิวินาที) perplexity_research ที่ค้นคว้าเชิงลึกอาจใช้เวลาหลายนาที
# PERPLEXITY_TIMEOUT_MS=300000
# endpoint ของ Perplexity API (เปลี่ยนเมื่อต้องเรียกผ่าน proxy ขององค์กร)
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
# proxy สำหรับเชื่อมต่ออินเทอร์เน็ต หากไม่กำหนดจะใช้ HTTPS_PROXY หรือ HTTP_PROXY ของระบบ (ถ้ามี)
# PERPLEXITY_PROXY=
# ระดับของ log: DEBUG | INFO | WARN | ERROR
# PERPLEXITY_LOG_LEVEL=ERROR

# --- MCP server ---
# ต้องกำหนดเป็น 0.0.0.0 เพื่อให้ agent ใน container อื่นเชื่อมต่อได้ (หากไม่กำหนดจะเป็น 127.0.0.1 ซึ่งเชื่อมต่อจากภายนอก container ไม่ได้)
BIND_ADDRESS=0.0.0.0
# รายชื่อ host:port ที่อนุญาต (ป้องกันการโจมตีแบบ DNS rebinding) คั่นด้วย , และต้องตรงทุกตัวอักษร ไม่รองรับ wildcard
#   mcp-perplexity:8080              = ชื่อที่ agent ใช้บน docker network (ห้ามลบ)
#   localhost:8803, 127.0.0.1:8803   = ใช้เรียกจากเครื่องนี้ผ่านพอร์ตที่เปิดไว้ เช่น curl .../health
#   <ชื่อเครื่อง>:8803, <IP>:8803     = เพิ่มเมื่อต้องการเรียกจากเครื่องอื่น (ชื่อเครื่องใช้ตัวพิมพ์เล็ก)
#   host ที่ไม่อยู่ในรายชื่อจะได้รับ HTTP 421 Misdirected Request
ALLOWED_HOSTS=mcp-perplexity:8080,localhost:8803,127.0.0.1:8803
# โดเมนของ MCP client แบบเว็บที่อนุญาตให้เรียกข้ามโดเมน คั่นด้วย , (agent ทั่วไปไม่จำเป็นต้องใช้)
# ALLOWED_ORIGINS=
# พอร์ตภายใน container (หากเปลี่ยน ต้องแก้ docker-compose.yml และ ALLOWED_HOSTS ให้ตรงกัน)
# PORT=8080

# --- เปิด/ปิดเครื่องมือ (tools-hook.mjs) ---
# true = เอเจนต์เห็นและเรียกใช้ได้ · false = ไม่อยู่ในรายการเครื่องมือเลย (ไม่เสีย token ค่าคำอธิบาย และเรียกตรงไม่ได้)
# เปลี่ยนแล้วสั่ง docker compose up -d และรีสตาร์ต Hermes (หรือ /reload-mcp) เพราะ client อ่านรายการเครื่องมือตอนเชื่อมต่อ
# ENABLE_PERPLEXITY_SEARCH=true
# ENABLE_PERPLEXITY_ASK=true
# ENABLE_PERPLEXITY_REASON=true
# ENABLE_PERPLEXITY_RESEARCH=true

# --- ข้อมูลการใช้งาน (usage-hook.mjs) ---
# บันทึก token เวลา และค่าใช้จ่ายของการเรียก Perplexity ทุกครั้ง (ไม่มีคำถามหรือคำตอบ) อ่านได้ที่ GET /usage
# USAGE_LOG=true
# โฟลเดอร์ภายใน container ที่เก็บไฟล์ usage-<วันที่>.jsonl (docker-compose.yml mount volume "usage" ไว้ที่นี่)
# USAGE_DIR=/app/usage
# พอร์ตภายใน container ของ GET /usage (0 = ไม่เปิด) ไม่ได้เปิดออกนอก docker network
# USAGE_PORT=8081
# หากกำหนด ผู้เรียก GET /usage ต้องส่ง "Authorization: Bearer <ค่านี้>" (ค่าลับ)
# USAGE_TOKEN=

# --- docker compose ---
# docker network ที่ใช้ร่วมกับ agent (ต้องสร้างก่อนด้วยคำสั่ง docker network create <ชื่อ>)
# DOCKER_NETWORK=agent_network
# 0.0.0.0 = เครื่องอื่นในเครือข่ายเข้าถึงได้ · 127.0.0.1 = เข้าถึงได้เฉพาะเครื่องนี้
#   ⚠ server นี้ไม่มีการยืนยันตัวตน ผู้ที่เข้าถึงได้จะใช้โควตา Perplexity ของคุณได้
# PUBLISH_ADDR=0.0.0.0
# พอร์ตบนเครื่อง (หากเปลี่ยน ต้องแก้ ALLOWED_HOSTS ให้ตรงกัน)
# PUBLISH_PORT=8803
