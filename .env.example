# =============================================================================
# mcp-perplexity — MCP server ค้นเว็บผ่าน Perplexity สำหรับ AI agent — ตัวอย่างไฟล์ .env
# เครื่องมือ: perplexity_search / perplexity_ask / perplexity_reason / perplexity_research
# -----------------------------------------------------------------------------
# ไฟล์นี้คือคู่มือของทุกค่าที่ปรับได้ แบ่งเป็น 3 หมวดเดียวกับ .env
# .env ของคุณใส่เฉพาะค่าที่ไม่มี # นำหน้า (ต้องตั้ง) และค่าที่ต้องการให้ต่างจากค่าเริ่มต้น
# ค่าที่มี # นำหน้าคือค่าเริ่มต้น — ไม่ใส่ใน .env ก็ใช้ค่านี้
# แก้ .env แล้วต้องสร้าง container ใหม่: docker compose up -d
# =============================================================================

# --- Perplexity API ---
# API key (ค่าลับ) — ขอได้ที่ https://console.perplexity.ai · ทุกการเรียกเครื่องมือคิดค่าใช้จ่ายกับ key นี้
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# เวลารอคำตอบจาก Perplexity สูงสุด (มิลลิวินาที) — perplexity_research ค้นเชิงลึกอาจใช้หลายนาที
# PERPLEXITY_TIMEOUT_MS=300000
# endpoint ของ Perplexity API (เปลี่ยนเมื่อใช้ proxy ขององค์กร)
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
# proxy สำหรับออกอินเทอร์เน็ต (ถ้าไม่ตั้ง จะใช้ HTTPS_PROXY / HTTP_PROXY ถ้ามี)
# PERPLEXITY_PROXY=
# ระดับ log: DEBUG | INFO | WARN | ERROR
# PERPLEXITY_LOG_LEVEL=ERROR

# --- MCP server ---
# ต้องเป็น 0.0.0.0 เพื่อให้ agent ใน container อื่นต่อเข้ามาได้ (ถ้าไม่ตั้ง จะเป็น 127.0.0.1 ซึ่งต่อจากภายนอก container ไม่ได้)
BIND_ADDRESS=0.0.0.0
# ชื่อ host:port ที่ยอมรับ (กันการโจมตีแบบ DNS rebinding) คั่นด้วย , — ต้องตรงทุกตัวอักษร ไม่มี wildcard
#   mcp-perplexity:8080              = ชื่อที่ agent ใช้บน docker network (ห้ามลบ)
#   localhost:8803, 127.0.0.1:8803   = เรียกจากเครื่องนี้ผ่านพอร์ตที่เปิดไว้ (เช่น curl .../health)
#   <ชื่อเครื่อง>:8803, <IP>:8803     = เพิ่มเมื่อจะเรียกจากเครื่องอื่น (ชื่อเครื่องใช้ตัวพิมพ์เล็ก)
#   host ที่ไม่อยู่ในรายการจะได้ HTTP 421 Misdirected Request
ALLOWED_HOSTS=mcp-perplexity:8080,localhost:8803,127.0.0.1:8803
# โดเมนของ MCP client แบบเว็บที่อนุญาตให้เรียกข้ามโดเมน คั่นด้วย , — agent ทั่วไปไม่ต้องใช้
# ALLOWED_ORIGINS=
# พอร์ตภายใน container (ถ้าเปลี่ยน ต้องแก้ docker-compose.yml และ ALLOWED_HOSTS ให้ตรง)
# PORT=8080

# --- docker compose ---
# docker network ที่ใช้ร่วมกับ agent (ต้องสร้างก่อน: docker network create <ชื่อ>)
# DOCKER_NETWORK=agent_network
# 0.0.0.0 = เครื่องอื่นในเครือข่ายเรียกได้ · 127.0.0.1 = เฉพาะเครื่องนี้
#   ⚠ server นี้ไม่มีระบบยืนยันตัวตน ใครเรียกได้ก็ใช้โควตา Perplexity ของคุณได้
# PUBLISH_ADDR=0.0.0.0
# พอร์ตบนเครื่อง — ถ้าเปลี่ยน ต้องแก้ ALLOWED_HOSTS ให้ตรง
# PUBLISH_PORT=8803
